# Flask session signing key
SECRET_KEY=change-me

# Wikimedia OAuth 1.0a
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
WIKIMEDIA_CONSUMER_KEY=
WIKIMEDIA_CONSUMER_SECRET=

# Optional. Must exactly match the callback URL registered for your consumer.
# Defaults to http://127.0.0.1:5000/callback when running locally.
# Consumers registered for out-of-band (OOB) auth work without this.
# WIKIMEDIA_REDIRECT_URI=http://127.0.0.1:5000/callback
